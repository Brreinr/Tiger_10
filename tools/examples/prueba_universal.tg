# 1. Variables originales en Tiger
ENT VAR vida = 100.
CAD VAR player = "HeroeTiger".

IMPRIMIR "=== [1] ESTADO INICIAL EN TIGER ===".
IMPRIMIR "Vida:".
IMPRIMIR vida.

# 2. Interoperabilidad con JavaScript (TIPO JS lee y modifica via TIGER)
TYPE JS {
    console.log("[JavaScript]: Leyendo TIGER.player -> " + TIGER.player);
    console.log("[JavaScript]: Leyendo TIGER.vida -> " + TIGER.vida);
    
    // Modificamos y creamos datos
    TIGER.vida = TIGER.vida + 50;
    TIGER.arma = "EspadaLaser";
}.

IMPRIMIR "=== [2] DESPUES DE TYPE JS ===".
IMPRIMIR "Nueva vida en Tiger:".
IMPRIMIR vida.
IMPRIMIR "Nueva arma traida desde JS:".
IMPRIMIR arma.

# 3. Interoperabilidad con Python (TIPO PY lee la variable creada en JS)
TYPE PY {
    print(f"[Python]: Leyendo TIGER.arma creada en JS -> {TIGER.arma}")
    TIGER.nivel = 99
}.

IMPRIMIR "=== [3] DESPUES DE TYPE PY ===".
IMPRIMIR "Nivel final creado desde Python:".
IMPRIMIR nivel.

