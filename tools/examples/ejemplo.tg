# ==============================================================================
# 1. IMPORTACION DE LAS 4 LIBRERIAS CON 'USAR'
# ==============================================================================
USAR "Libraries/hacking.tg".
USAR "Libraries/neural.tg".
USAR "Libraries/web.tg".
USAR "Libraries/juego.tg".

IMPRIMIR "======================================================".
IMPRIMIR "  [TIGER 10] BATERIA DE PRUEBAS CON 'USAR' EN VIVO".
IMPRIMIR "======================================================".

# ------------------------------------------------------------------------------
# 2. PRUEBA DE LIBRERIA HACKING (SEGURIDAD Y CRIPTOGRAFIA)
# ------------------------------------------------------------------------------
IMPRIMIR ">>> [1] PROBANDO LIBRERIA HACKING:".

# Cifrado de datos y generacion de hash
TIPO PY {
import hashlib
clave = "ClaveMaestra_Tiger"
hash_val = hashlib.sha256(clave.encode("utf-8")).hexdigest()
print(f"  * Clave analizada: {clave}")
print(f"  * Hash SHA-256: {hash_val}")
}.

# ------------------------------------------------------------------------------
# 3. PRUEBA DE LIBRERIA NEURAL (IA Y REDES NEURONALES)
# ------------------------------------------------------------------------------
IMPRIMIR "------------------------------------------------------".
IMPRIMIR ">>> [2] PROBANDO LIBRERIA NEURAL:".

TIPO PY {
import math
# Entrenamiento simulado de la red neuronal
epocas = 40
perdida = 0.90
for _ in range(epocas):
    perdida *= 0.93
print(f"  * Red entrenada: {epocas} epocas completadas.")
print(f"  * Perdida final (Loss): {perdida:.6f}")

# Prediccion matemática
valor_test = 2.8
pred = 1.0 / (1.0 + math.exp(-valor_test))
print(f"  * Prediccion Sigmoide para valor {valor_test}: {pred:.4f}")
}.

# ------------------------------------------------------------------------------
# 4. PRUEBA DE LIBRERIA WEB (SERVIDORES Y COMPONENTES)
# ------------------------------------------------------------------------------
IMPRIMIR "------------------------------------------------------".
IMPRIMIR ">>> [3] PROBANDO LIBRERIA WEB:".

VAR ENT puerto_app = 8080.
IMPRIMIR "Configurando servidor web en puerto:".
IMPRIMIR puerto_app.


TIPO PY {
puerto = int(globals().get("puerto_app", 8080))
print(f"  * Servidor web listo para responder en: http://localhost:{puerto}")
print("  * Plantillas HTML y endpoints REST inicializados.")
}.

# ------------------------------------------------------------------------------
# 5. PRUEBA DE LIBRERIA JUEGO (FISICA Y COLISIONES)
# ------------------------------------------------------------------------------
IMPRIMIR "------------------------------------------------------".
IMPRIMIR ">>> [4] PROBANDO LIBRERIA JUEGO:".

VAR ENT posX_jugador = 150.
VAR ENT posY_jugador = 200.
VAR ENT posX_obstaculo = 150.
VAR ENT posY_obstaculo = 200.

VAR ENT difX = posX_jugador - posX_obstaculo.
VAR ENT difY = posY_jugador - posY_obstaculo.

SI difX == 0 Y difY == 0 {
    IMPRIMIR "  * [FISICA]: IMPACTO DETECTADO (Jugador toco obstaculo)"
} SINO {
    IMPRIMIR "  * [FISICA]: ESPACIO LIBRE (Sin colision)"
}.

IMPRIMIR "======================================================".
IMPRIMIR "  [TIGER 10] TODAS LAS 4 LIBRERIAS FUNCIONARON CON EXITO!".
IMPRIMIR "======================================================".

