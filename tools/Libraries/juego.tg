USAR EN ASM Y WAT.

# ==============================================================================
# LIBRERÍA DE DESARROLLO DE VIDEOJUEGOS 2D - TIGER 10
# Clases para Motor de Juego, Entidades, Sprites, Físicas y Bucle Principal
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENTIDAD / JUGADOR / PERSONAJE
# ------------------------------------------------------------------------------
Entidad {
    CRE ENT pos_x = 0,
    CRE ENT pos_y = 0,
    CRE ENT velocidad = 5,
    CRE ENT vida = 100,
    CRE ENT activa = 1,

    FN iniciar(ENT px | ENT py) {
        pos_x <- px,
        pos_y <- py,
        vida <- 100,
        activa <- 1,
        RETORNAR 1
    },

    FN mover(ENT dx | ENT dy) {
        pos_x <- pos_x + (dx * velocidad),
        pos_y <- pos_y + (dy * velocidad),
        RETORNAR pos_x
    },

    FN recibir_danio(ENT cantidad) {
        vida <- vida - cantidad,
        SI vida <= 0 {
            vida <- 0,
            activa <- 0,
            IMPRIMIR "Entidad derrotada.",
            RETORNAR 0
        },
        RETORNAR vida
    },

    FN curar(ENT cantidad) {
        vida <- vida + cantidad,
        SI vida > 100 {
            vida <- 100
        },
        RETORNAR vida
    }
}.

# ------------------------------------------------------------------------------
# 2. MOTOR DEL BUCLE DE JUEGO (GAME LOOP)
# ------------------------------------------------------------------------------
MotorJuego {
    CRE ENT fps = 60,
    CRE ENT cuadros_totales = 0,
    CRE ENT corriendo = 1,
    CRE ENT delta_ms = 16,

    FN configurar(ENT objetivo_fps) {
        fps <- objetivo_fps,
        cuadros_totales <- 0,
        corriendo <- 1,
        delta_ms <- 1000 / objetivo_fps,
        IMPRIMIR "[Motor2D] Configurado a FPS:",
        IMPRIMIR fps,
        RETORNAR 1
    },

    FN actualizar() {
        cuadros_totales <- cuadros_totales + 1,
        RETORNAR cuadros_totales
    },

    FN detener() {
        corriendo <- 0,
        IMPRIMIR "[Motor2D] Bucle de juego detenido.",
        RETORNAR 0
    }
}.

# Alias en inglés para compatibilidad bilingüe
GameEngine {
    CRE ENT fps = 60,
    CRE ENT running = 1,

    FN tick() {
        RETORNAR 1
    }
}.

# ------------------------------------------------------------------------------
# 3. COLISIONES Y CAJAS DELIMITADORAS (AABB)
# ------------------------------------------------------------------------------
CajaColision {
    CRE ENT c_x = 0,
    CRE ENT c_y = 0,
    CRE ENT ancho = 32,
    CRE ENT alto = 32,

    FN posicionar(ENT px | ENT py | ENT w | ENT h) {
        c_x <- px,
        c_y <- py,
        ancho <- w,
        alto <- h,
        RETORNAR 1
    },

    FN colisiona_con(ENT otro_x | ENT otro_y | ENT otro_w | ENT otro_h) {
        SI c_x < otro_x + otro_w {
            SI c_x + ancho > otro_x {
                SI c_y < otro_y + otro_h {
                    SI c_y + alto > otro_y {
                        RETORNAR 1
                    }
                }
            }
        },
        RETORNAR 0
    }
}.

# ------------------------------------------------------------------------------
# 4. SISTEMA DE AUDIO Y EFECTOS
# ------------------------------------------------------------------------------
Audio {
    CRE ENT volumen = 100,
    CRE ENT mute = 0,

    FN reproducir(CAD archivo_audio) {
        SI mute == 0 {
            IMPRIMIR "[Audio] Reproduciendo efecto:",
            IMPRIMIR archivo_audio,
            RETORNAR 1
        },
        RETORNAR 0
    },

    FN silenciar() {
        mute <- 1,
        RETORNAR 1
    }
}.

# ------------------------------------------------------------------------------
# 5. FUNCIONES RÁPIDAS
# ------------------------------------------------------------------------------
FN iniciar_partida(ENT vidas) {
    IMPRIMIR "[Juego] Partida iniciada con vidas:",
    IMPRIMIR vidas,
    RETORNAR vidas
}.
