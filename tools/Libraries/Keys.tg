FN tecla_shift() { RETORNAR tecla_presionada(16) }.
FN tecla_escape() { RETORNAR tecla_presionada(27) }.
FN tecla_reiniciar() { RETORNAR tecla_presionada(82) }.
FN tecla_w() { RETORNAR tecla_presionada(87) }.
FN tecla_a() { RETORNAR tecla_presionada(65) }.
FN tecla_s() { RETORNAR tecla_presionada(83) }.
FN tecla_d() { RETORNAR tecla_presionada(68) }.
