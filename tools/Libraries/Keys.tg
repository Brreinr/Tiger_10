# Acceso directo: consultar cualquier VK sin crear una clase adicional.
Teclado {
    FN presionada(ENT codigo) { RETORNAR tecla_presionada(codigo) },
    FN letra(ENT codigo_ascii) { RETORNAR tecla_presionada(codigo_ascii) },
    FN flecha_arriba() { RETORNAR tecla_presionada(38) },
    FN flecha_abajo() { RETORNAR tecla_presionada(40) },
    FN flecha_izquierda() { RETORNAR tecla_presionada(37) },
    FN flecha_derecha() { RETORNAR tecla_presionada(39) },
    FN espacio() { RETORNAR tecla_presionada(32) },
    FN escape() { RETORNAR tecla_presionada(27) },
    FN modificador(ENT codigo) { RETORNAR tecla_presionada(codigo) }
}.

# Funciones publicas para usar el teclado sin depender de la sintaxis de metodos.
FN tecla_juego(ENT codigo) { RETORNAR tecla_presionada(codigo) }.
FN tecla_arriba() { RETORNAR tecla_presionada(38) }.
