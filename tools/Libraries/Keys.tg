USAR EN ASM Y WAT.

# ======================================================================
# TECLADO: clases por tecla con codigos virtuales de Windows (VK).
# Cada instancia puede consultarse en un bucle usando actualizar().
# Los eventos de pulsacion y liberacion son transiciones entre cuadros.
# ======================================================================

Tecla {
    CRE ENT codigo = 0,
    CRE CAD nombre = "",
    CRE ENT anterior = 0,
    CRE ENT actual = 0,
    CRE ENT habilitada = 1,

    FN configurar(ENT vk | CAD etiqueta) {
        codigo <- vk,
        nombre <- etiqueta,
        anterior <- 0,
        actual <- 0,
        RETORNAR codigo
    },
    FN actualizar() {
        anterior <- actual,
        actual <- tecla_presionada(codigo),
        RETORNAR actual
    },
    FN presionada() { RETORNAR actual },
    FN mantenida() { RETORNAR actual },
    FN soltada() { RETORNAR anterior - actual },
    FN evento() { RETORNAR actual - anterior },
    FN habilitar() { habilitada <- 1, RETORNAR habilitada },
    FN deshabilitar() { habilitada <- 0, actual <- 0, RETORNAR habilitada }
}.

