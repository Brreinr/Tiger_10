    RETORNAR 1
}.

# Diálogos emergentes con soporte UTF-8 completo
FN ventana_alerta(CAD t | CAD msg) {
    _tiger_win_t <- t,
    _tiger_lbl2_txt <- msg,
    TIPO PY {
import os, tempfile
p = os.path.join(tempfile.gettempdir(), "_tiger_dialog.cfg")
with open(p, "w", encoding="utf-8") as f:
    f.write(f"{TIGER._tiger_win_t}\n{TIGER._tiger_lbl2_txt}\n")
    },
    TIPO C {
#include <tiger.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#if defined(_WIN32) || defined(_WIN64)
#pragma comment(lib, "user32")
#pragma comment(lib, "kernel32")
#include <windows.h>

#ifndef CP_UTF8
#define CP_UTF8 65001
#endif

int WINAPI MultiByteToWideChar(UINT CodePage, DWORD dwFlags, LPCSTR lpMultiByteStr, int cbMultiByte, LPWSTR lpWideCharStr, int cchWideChar);

static void utf8_to_wide(const char* utf8, wchar_t* wide, int max_chars) {
    if (!utf8 || !wide || max_chars <= 0) return;
    wide[0] = 0;
    MultiByteToWideChar(CP_UTF8, 0, utf8, -1, wide, max_chars);
}

int main() {
    char cfg_path[512];
    GetTempPathA(512, cfg_path);
    strcat(cfg_path, "_tiger_dialog.cfg");
    FILE* f = fopen(cfg_path, "r");
    char title[256] = "Tiger 10";
    char msg[1024] = "Alerta del Sistema";
    if (f) {
        if (fgets(title, sizeof(title), f)) title[strcspn(title, "\r\n")] = 0;
        if (fgets(msg, sizeof(msg), f)) msg[strcspn(msg, "\r\n")] = 0;
        fclose(f);
    }
    wchar_t w_title[256];
    wchar_t w_msg[1024];
    utf8_to_wide(title, w_title, 256);
    utf8_to_wide(msg, w_msg, 1024);
    MessageBoxW(NULL, w_msg, w_title, MB_OK | MB_ICONINFORMATION);
    TIGER->exito("Dialogo Unicode cerrado.");
    return 0;
}
#else
int main() {
    TIGER->log("ALERTA", "Dialogo completado.");
    return 0;
}
#endif
    },
    RETORNAR 1
}.

FN window_alert(CAD t | CAD msg) {
    ventana_alerta(t | msg),
    RETORNAR 1
}.
