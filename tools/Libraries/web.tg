USAR EN WAT.

# ==============================================================================
# LIBRERÍA WEB - TIGER 10
# Componentes para Páginas Web, Ventanas Modales, Botones, Estilos y Animaciones
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVIDOR BÁSICO
# ------------------------------------------------------------------------------
Servidor {
    CRE ENT puerto = 8080,
    CRE ENT activo = 1,

    FN iniciar(ENT p) {
        puerto <- p,
        activo <- 1,
        IMPRIMIR "Iniciando servidor localhost en puerto:",
        IMPRIMIR puerto,
        TIPO PY {
import webbrowser, http.server, socketserver, sys, os

# Resolver el puerto dinámicamente
port = 8080
for _k, _v in list(globals().items()):
    if "puerto" in _k.lower() or _k == "p":
        try:
            port = int(_v)
            break
        except (ValueError, TypeError):
            pass

url = f"http://localhost:{port}"

html_content = """<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tiger 10 Web App</title>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #0f172a; color: #f8fafc; margin: 0; padding: 0; min-height: 100vh; display: flex; justify-content: center; align-items: center; }
        .tiger-btn { background: #0284c7; color: #ffffff; border: none; border-radius: 8px; padding: 12px 24px; font-size: 16px; font-weight: 600; cursor: pointer; transition: all 0.25s ease; box-shadow: 0 4px 14px rgba(2, 132, 199, 0.4); }
        .tiger-btn:hover { background: #0369a1; transform: translateY(-2px); box-shadow: 0 6px 20px rgba(2, 132, 199, 0.6); }
        .tiger-window { background: #1e293b; border-radius: 12px; border: 1px solid #334155; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5); width: 480px; overflow: hidden; animation: tigerPop 0.4s cubic-bezier(0.16, 1, 0.3, 1); }
        .tiger-header { background: #0f172a; padding: 14px 20px; font-weight: 600; border-bottom: 1px solid #334155; display: flex; justify-content: space-between; align-items: center; color: #e2e8f0; }
        .tiger-close-btn { background: transparent; border: none; color: #94a3b8; font-size: 22px; line-height: 1; cursor: pointer; border-radius: 4px; padding: 2px 6px; }
        .tiger-close-btn:hover { color: #f8fafc; background: #334155; }
        .tiger-body { padding: 28px; }
        .tiger-body h2 { margin-top: 0; color: #38bdf8; font-size: 24px; }
        .tiger-body p { color: #94a3b8; line-height: 1.6; margin-bottom: 24px; font-size: 15px; }
        @keyframes tigerPop { from { opacity: 0; transform: scale(0.95) translateY(10px); } to { opacity: 1; transform: scale(1) translateY(0); } }
    </style>
</head>
<body>
    <div class="tiger-window" id="win-principal">
        <div class="tiger-header">
            <span>Ventana Tiger 10</span>
            <button class="tiger-close-btn" onclick="document.getElementById('win-principal').style.display='none'">&times;</button>
        </div>
        <div class="tiger-body">
            <h2>¡Hola mundo!</h2>
            <p>Página web y ventana con botón azul servidas en tiempo real desde <strong>http://localhost:8080</strong> usando la librería <strong>web.tg</strong> de Tiger 10.</p>
            <button class="tiger-btn" onclick="alert('¡Hola mundo desde Tiger 10 en tu navegador!')">Botón Azul</button>
        </div>
    </div>
</body>
</html>"""

# Guardar index.html para persistencia
try:
    with open("index.html", "w", encoding="utf-8") as _f:
        _f.write(html_content)
except Exception:
    pass

class TigerHTTPHandler(http.server.SimpleHTTPRequestHandler):
    def do_GET(self):
        if self.path in {"/", "/index.html"}:
            raw = html_content.encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(raw)))
            self.end_headers()
            self.wfile.write(raw)
        else:
            super().do_GET()
    def log_message(self, *args):
        pass

sys.__stdout__.write(f"\n======================================================\n")
sys.__stdout__.write(f"  [Servidor Tiger 10] Iniciado en: {url}\n")
sys.__stdout__.write(f"  [Navegador] Abriendo {url} ...\n")
sys.__stdout__.write(f"  [Listo] Presiona Ctrl+C en la consola para detener.\n")
sys.__stdout__.write(f"======================================================\n\n")
sys.__stdout__.flush()

webbrowser.open(url)

socketserver.TCPServer.allow_reuse_address = True
try:
    with socketserver.TCPServer(("127.0.0.1", port), TigerHTTPHandler) as httpd:
        httpd.serve_forever()
except KeyboardInterrupt:
    sys.__stdout__.write("\n[Servidor Tiger 10] Detenido por el usuario.\n")
    sys.__stdout__.flush()
except OSError:
    sys.__stdout__.write(f"[Aviso] El puerto {port} ya estaba activo. Página abierta en navegador.\n")
    sys.__stdout__.flush()
        },
        RETORNAR puerto
    },
    FN detener() {
        activo <- 0,
        IMPRIMIR "Servidor detenido.",
        RETORNAR 0
    }
}.

# ------------------------------------------------------------------------------
# 2. CLIENTE / CONEXIÓN WEB
# ------------------------------------------------------------------------------
Web {
    CRE CAD url = "http://localhost",
    CRE ENT estado = 200,
    FN conectar(ENT p) {
        IMPRIMIR "Conectado al servidor web en puerto:",
        IMPRIMIR p,
        RETORNAR 1
    }
}.

# ------------------------------------------------------------------------------
# 3. PÁGINA WEB (HTML & HEAD)
# ------------------------------------------------------------------------------
Pagina {
    CRE CAD titulo = "Tiger 10 Web App",
    CRE CAD lang = "es",
    CRE CAD fondo = "#ffffff",
    CRE ENT total_elementos = 0,

    FN configurar(CAD t | CAD l | CAD color_fondo) {
        titulo <- t,
        lang <- l,
        fondo <- color_fondo,
        RETORNAR 1
    },

    FN encabezado() {
        IMPRIMIR "<!DOCTYPE html>",
        IMPRIMIR "<html lang='",
        IMPRIMIR lang,
        IMPRIMIR "'>",
        IMPRIMIR "<head><meta charset='UTF-8'><title>",
        IMPRIMIR titulo,
        IMPRIMIR "</title></head><body style='margin:0; background:",
        IMPRIMIR fondo,
        IMPRIMIR ";'>",
        RETORNAR 1
    },

    FN pie() {
        IMPRIMIR "</body></html>",
        RETORNAR 1
    }
}.

# ------------------------------------------------------------------------------
# 4. VENTANAS Y PANELES FLOTANTES (MODALS / WINDOWS)
# ------------------------------------------------------------------------------
Ventana {
    CRE CAD id = "win-main",
    CRE CAD titulo = "Ventana",
    CRE ENT ancho = 450,
    CRE ENT alto = 320,
    CRE ENT visible = 1,
    CRE CAD estilo = "position:fixed; top:20%; left:30%; border:1px solid #333; background:#fff; border-radius:8px; box-shadow:0 8px 24px rgba(0,0,0,0.2);",

    FN crear(CAD id_win | CAD t | ENT w | ENT h) {
        id <- id_win,
        titulo <- t,
        ancho <- w,
        alto <- h,
        visible <- 1,
        RETORNAR 1
    },

    FN abrir() {
        visible <- 1,
        RETORNAR 1
    },

    FN cerrar() {
        visible <- 0,
        RETORNAR 0
    },

    FN renderizar(CAD contenido) {
        SI visible == 1 {
            IMPRIMIR "<div id='",
            IMPRIMIR id,
            IMPRIMIR "' style='",
            IMPRIMIR estilo,
            IMPRIMIR " width:",
            IMPRIMIR ancho,
            IMPRIMIR "px; height:",
            IMPRIMIR alto,
            IMPRIMIR "px;'>",
            IMPRIMIR "<div style='background:#1f2937; color:#fff; padding:10px 14px; font-weight:bold; display:flex; justify-content:space-between;'>",
            IMPRIMIR "<span>",
            IMPRIMIR titulo,
            IMPRIMIR "</span><button onclick='this.parentElement.parentElement.style.display=\"none\";'>&times;</button></div>",
            IMPRIMIR "<div style='padding:16px;'>",
            IMPRIMIR contenido,
            IMPRIMIR "</div></div>"
        },
        RETORNAR visible
    }
}.

# ------------------------------------------------------------------------------
# 5. BOTONES INTERACTIVOS
# ------------------------------------------------------------------------------
Boton {
    CRE CAD id = "btn-1",
    CRE CAD rotulo = "Aceptar",
    CRE CAD accion = "alert('Tiger 10!')",
    CRE CAD estilo_css = "tiger-btn",
    CRE ENT habilitado = 1,

    FN crear(CAD btn_id | CAD label | CAD on_click) {
        id <- btn_id,
        rotulo <- label,
        accion <- on_click,
        habilitado <- 1,
        RETORNAR 1
    },

    FN deshabilitar() {
        habilitado <- 0,
        RETORNAR 0
    },

    FN habilitar() {
        habilitado <- 1,
        RETORNAR 1
    },

    FN renderizar() {
        IMPRIMIR "<button id='",
        IMPRIMIR id,
        IMPRIMIR "' class='",
        IMPRIMIR estilo_css,
        IMPRIMIR "' onclick='",
        IMPRIMIR accion,
        IMPRIMIR "' style='cursor:pointer; padding:10px 20px; font-weight:600; border-radius:6px; border:none; transition:all 0.3s ease;'>",
        IMPRIMIR rotulo,
        IMPRIMIR "</button>",
        RETORNAR 1
    }
}.

# ------------------------------------------------------------------------------
# 6. MOTOR DE ESTILOS CSS
# ------------------------------------------------------------------------------
Estilo {
    CRE CAD selector = ".tiger-btn",
    CRE CAD fondo = "#2563eb",
    CRE CAD color_letra = "#ffffff",
    CRE ENT radio = 6,
    CRE ENT padding_px = 12,

    FN configurar(CAD sel | CAD bg | CAD color | ENT r | ENT pad) {
        selector <- sel,
        fondo <- bg,
        color_letra <- color,
        radio <- r,
        padding_px <- pad,
        RETORNAR 1
    },

    FN renderizar() {
        IMPRIMIR "<style>",
        IMPRIMIR selector,
        IMPRIMIR " { background:",
        IMPRIMIR fondo,
        IMPRIMIR "; color:",
        IMPRIMIR color_letra,
        IMPRIMIR "; border-radius:",
        IMPRIMIR radio,
        IMPRIMIR "px; padding:",
        IMPRIMIR padding_px,
        IMPRIMIR "px; } ",
        IMPRIMIR selector,
        IMPRIMIR ":hover { filter:brightness(1.15); transform:scale(1.02); }",
        IMPRIMIR "</style>",
        RETORNAR 1
    }
}.

# ------------------------------------------------------------------------------
# 7. MOTOR DE ANIMACIONES CSS & KEYFRAMES
# ------------------------------------------------------------------------------
Animacion {
    CRE CAD nombre = "tigerFadeIn",
    CRE CAD variante = "fade",
    CRE ENT duracion_ms = 400,
    CRE ENT repeticiones = 1,

    FN crear(CAD anim_nombre | CAD anim_variante | ENT dur_ms) {
        nombre <- anim_nombre,
        variante <- anim_variante,
        duracion_ms <- dur_ms,
        repeticiones <- 1,
        RETORNAR 1
    },

    FN renderizar() {
        IMPRIMIR "<style>",
        IMPRIMIR "@keyframes ",
        IMPRIMIR nombre,
        IMPRIMIR " { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:translateY(0); } }",
        IMPRIMIR ".",
        IMPRIMIR nombre,
        IMPRIMIR " { animation:",
        IMPRIMIR nombre,
        IMPRIMIR " ",
        IMPRIMIR duracion_ms,
        IMPRIMIR "ms cubic-bezier(0.16, 1, 0.3, 1) forwards; }",
        IMPRIMIR "</style>",
        RETORNAR 1
    }
}.

# ------------------------------------------------------------------------------
# 8. FUNCIONES RÁPIDAS DE COMPILACIÓN / CONVENIENCIA
# ------------------------------------------------------------------------------
FN servidor_iniciar(ENT puerto) {
    IMPRIMIR "Servidor iniciado en puerto:",
    IMPRIMIR puerto,
    RETORNAR 1
}.
