USAR EN WAT.

# ==============================================================================
# LIBRERÍA GUI ULTRA-MODERNA Y CREATIVA CON UTF-8 COMPLETO - TIGER 10 (web.tg)
# ==============================================================================
# Soporta:
#   - Codificación UTF-8 completa: 'ñ', 'Ñ', acentos (á, é, í, ó, ú), ¿, ¡
#   - Símbolos especiales y emojis: ★, ⚡, ⚔, 🛡, 🚀, 🔥, 🎯, 💎, ▶, ■, ▲, ▼, ♥
#   - Motor Win32 Unicode Wide (TextOutW, CreateWindowExW, MessageBoxW)
#   - Presets modernos (cyberpunk, gaming, tiger_neon, glass, minimalista)
#   - Colores HEX directos (#ff6b00, #00f3ff, #22c55e, #ff0055, etc.)
# ==============================================================================

# Variables de puente dinámicas para ventana
ENT VAR _tiger_win_w = 800.
ENT VAR _tiger_win_h = 550.
CAD VAR _tiger_win_t = "Tiger Modern GUI".
ENT VAR _tiger_win_fullscreen = 0.
ENT VAR _tiger_win_borderless = 0.
ENT VAR _tiger_win_topmost = 0.
ENT VAR _tiger_win_opacity = 96.
CAD VAR _tiger_win_theme = "tiger".
CAD VAR _tiger_win_bg = "#121214".

# Variables de puente: Título, Subtítulo e Insignia (Badge)
ENT VAR _tiger_lbl1_act = 1.
ENT VAR _tiger_lbl1_x = 45.
ENT VAR _tiger_lbl1_y = 35.
CAD VAR _tiger_lbl1_col = "#ff6b00".
CAD VAR _tiger_lbl1_txt = "TIGER ENGINE 10 — CENTRO DE CONTROL".

ENT VAR _tiger_lbl2_act = 1.
ENT VAR _tiger_lbl2_x = 45.
ENT VAR _tiger_lbl2_y = 70.
CAD VAR _tiger_lbl2_col = "#94a3b8".
CAD VAR _tiger_lbl2_txt = "Soporte nativo UTF-8 con ñ, acentos y simbolos especiales".

ENT VAR _tiger_badge_act = 1.
ENT VAR _tiger_badge_x = 600.
ENT VAR _tiger_badge_y = 35.
CAD VAR _tiger_badge_col = "#22c55e".
CAD VAR _tiger_badge_txt = "[UTF-8 ACTIVO]".

# Variables de puente: Barra de Progreso 1 (Salud / Principal)
ENT VAR _tiger_prg1_act = 1.
ENT VAR _tiger_prg1_val = 85.
ENT VAR _tiger_prg1_x = 45.
ENT VAR _tiger_prg1_y = 115.
ENT VAR _tiger_prg1_w = 400.
ENT VAR _tiger_prg1_h = 24.
CAD VAR _tiger_prg1_col = "#ff6b00".
CAD VAR _tiger_prg1_tag = "ENERGIA DISPONIBLE (85%)".

# Variables de puente: Barra de Progreso 2 (Escudo / Secundaria)
ENT VAR _tiger_prg2_act = 1.
ENT VAR _tiger_prg2_val = 60.
ENT VAR _tiger_prg2_x = 45.
ENT VAR _tiger_prg2_y = 155.
ENT VAR _tiger_prg2_w = 400.
ENT VAR _tiger_prg2_h = 24.
CAD VAR _tiger_prg2_col = "#00f3ff".
CAD VAR _tiger_prg2_tag = "ESCUDO CUANTICO (60%)".

# Variables de puente: Entrada de texto
ENT VAR _tiger_in_act = 1.
ENT VAR _tiger_in_x = 45.
ENT VAR _tiger_in_y = 205.
ENT VAR _tiger_in_w = 400.
ENT VAR _tiger_in_h = 36.
CAD VAR _tiger_in_txt = "Escribe aqui usando ñ, tildes y simbolos...".

# Variables de puente: Botón 1 (Principal) y Botón 2 (Secundario)
ENT VAR _tiger_btn1_act = 1.
ENT VAR _tiger_btn1_x = 45.
ENT VAR _tiger_btn1_y = 265.
ENT VAR _tiger_btn1_w = 190.
ENT VAR _tiger_btn1_h = 45.
CAD VAR _tiger_btn1_txt = "INICIAR MISION".

ENT VAR _tiger_btn2_act = 1.
ENT VAR _tiger_btn2_x = 255.
ENT VAR _tiger_btn2_y = 265.
ENT VAR _tiger_btn2_w = 190.
ENT VAR _tiger_btn2_h = 45.
CAD VAR _tiger_btn2_txt = "CONFIGURACION".

# ------------------------------------------------------------------------------
# 1. MOTOR NATIVO MULTIPLATAFORMA UNICODE (TIPO C CON TIGER.H)
# ------------------------------------------------------------------------------
FN ventana_abrir(CAD t | ENT w | ENT h) {
    _tiger_win_t <- t,
    _tiger_win_w <- w,
    _tiger_win_h <- h,
    TIPO PY {
import os, tempfile
p = os.path.join(tempfile.gettempdir(), "_tiger_ui_pro.cfg")
with open(p, "w", encoding="utf-8") as f:
    f.write(f"{TIGER._tiger_win_w}\n{TIGER._tiger_win_h}\n{TIGER._tiger_win_fullscreen}\n{TIGER._tiger_win_borderless}\n{TIGER._tiger_win_topmost}\n{TIGER._tiger_win_opacity}\n{TIGER._tiger_win_theme}\n{TIGER._tiger_win_bg}\n{TIGER._tiger_win_t}\n")
    f.write(f"{TIGER._tiger_lbl1_act}\n{TIGER._tiger_lbl1_x}\n{TIGER._tiger_lbl1_y}\n{TIGER._tiger_lbl1_col}\n{TIGER._tiger_lbl1_txt}\n")
    f.write(f"{TIGER._tiger_lbl2_act}\n{TIGER._tiger_lbl2_x}\n{TIGER._tiger_lbl2_y}\n{TIGER._tiger_lbl2_col}\n{TIGER._tiger_lbl2_txt}\n")
    f.write(f"{TIGER._tiger_badge_act}\n{TIGER._tiger_badge_x}\n{TIGER._tiger_badge_y}\n{TIGER._tiger_badge_col}\n{TIGER._tiger_badge_txt}\n")
    f.write(f"{TIGER._tiger_prg1_act}\n{TIGER._tiger_prg1_val}\n{TIGER._tiger_prg1_x}\n{TIGER._tiger_prg1_y}\n{TIGER._tiger_prg1_w}\n{TIGER._tiger_prg1_h}\n{TIGER._tiger_prg1_col}\n{TIGER._tiger_prg1_tag}\n")
    f.write(f"{TIGER._tiger_prg2_act}\n{TIGER._tiger_prg2_val}\n{TIGER._tiger_prg2_x}\n{TIGER._tiger_prg2_y}\n{TIGER._tiger_prg2_w}\n{TIGER._tiger_prg2_h}\n{TIGER._tiger_prg2_col}\n{TIGER._tiger_prg2_tag}\n")
    f.write(f"{TIGER._tiger_in_act}\n{TIGER._tiger_in_x}\n{TIGER._tiger_in_y}\n{TIGER._tiger_in_w}\n{TIGER._tiger_in_h}\n{TIGER._tiger_in_txt}\n")
    f.write(f"{TIGER._tiger_btn1_act}\n{TIGER._tiger_btn1_x}\n{TIGER._tiger_btn1_y}\n{TIGER._tiger_btn1_w}\n{TIGER._tiger_btn1_h}\n{TIGER._tiger_btn1_txt}\n")
    f.write(f"{TIGER._tiger_btn2_act}\n{TIGER._tiger_btn2_x}\n{TIGER._tiger_btn2_y}\n{TIGER._tiger_btn2_w}\n{TIGER._tiger_btn2_h}\n{TIGER._tiger_btn2_txt}\n")
    },
    TIPO C {
#include <tiger.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#if defined(_WIN32) || defined(_WIN64)
#pragma comment(lib, "user32")
#pragma comment(lib, "gdi32")
#pragma comment(lib, "kernel32")
#include <windows.h>

#ifndef CP_UTF8
#define CP_UTF8 65001
#endif

int WINAPI MultiByteToWideChar(UINT CodePage, DWORD dwFlags, LPCSTR lpMultiByteStr, int cbMultiByte, LPWSTR lpWideCharStr, int cchWideChar);

static void utf8_to_wide(const char* utf8, wchar_t* wide, int max_chars) {
    if (!utf8 || !wide || max_chars <= 0) return;
    wide[0] = 0;
    MultiByteToWideChar(CP_UTF8, 0, utf8, -1, wide, max_chars);
}

static COLORREF parse_hex(const char* hex, COLORREF def) {
    if (!hex) return def;
    if (hex[0] == '#') hex++;
    if (strlen(hex) < 6) return def;
    unsigned int r = 0, g = 0, b = 0;
    if (sscanf(hex, "%02x%02x%02x", &r, &g, &b) == 3) {
        return RGB(r, g, b);
    }
    return def;
}

static COLORREF g_bg_color = RGB(18, 18, 20);
static HBRUSH   g_hBgBrush = NULL;

static int g_p1_act = 0, g_p1_val = 0, g_p1_x = 0, g_p1_y = 0, g_p1_w = 0, g_p1_h = 0;
static COLORREF g_p1_col = RGB(255, 107, 0);
static wchar_t g_p1_tag_w[128] = L"";

static int g_p2_act = 0, g_p2_val = 0, g_p2_x = 0, g_p2_y = 0, g_p2_w = 0, g_p2_h = 0;
static COLORREF g_p2_col = RGB(0, 243, 255);
static wchar_t g_p2_tag_w[128] = L"";

static int g_badge_act = 0, g_badge_x = 0, g_badge_y = 0;
static COLORREF g_badge_col = RGB(34, 197, 94);
static wchar_t g_badge_w[128] = L"";

static wchar_t g_lbl1_w[256] = L"";
static wchar_t g_lbl2_w[256] = L"";
static COLORREF g_lbl1_col = RGB(255, 107, 0);
static COLORREF g_lbl2_col = RGB(148, 163, 184);

static HFONT g_hFontTitle = NULL;
static HFONT g_hFontSub = NULL;
static HFONT g_hFontBadge = NULL;
static HFONT g_hFontBar = NULL;

static LRESULT CALLBACK _TigerWndProcModern(HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam) {
    switch (msg) {
        case WM_DESTROY:
            PostQuitMessage(0);
            return 0;
        case WM_COMMAND: {
            int id = LOWORD(wParam);
            if (id == 2001 && HIWORD(wParam) == BN_CLICKED) {
                MessageBeep(MB_ICONASTERISK);
                MessageBoxW(hwnd, L"Accion ejecutada con exito en Tiger! (Boton 1)", L"Tiger GUI Unicode", MB_OK | MB_ICONINFORMATION);
            } else if (id == 2002 && HIWORD(wParam) == BN_CLICKED) {
                MessageBeep(MB_OK);
                MessageBoxW(hwnd, L"Panel de Configuracion Abierto! (Boton 2)", L"Tiger GUI Unicode", MB_OK | MB_ICONINFORMATION);
            }
            break;
        }
        case WM_PAINT: {
            PAINTSTRUCT ps;
            HDC hdc = BeginPaint(hwnd, &ps);
            SetBkMode(hdc, TRANSPARENT);

            // 1. Dibujar Titulo con soporte completo UTF-8
            if (wcslen(g_lbl1_w) > 0) {
                SelectObject(hdc, g_hFontTitle);
                SetTextColor(hdc, g_lbl1_col);
                TextOutW(hdc, 45, 30, g_lbl1_w, (int)wcslen(g_lbl1_w));
            }

            // 2. Dibujar Subtitulo con soporte completo UTF-8
            if (wcslen(g_lbl2_w) > 0) {
                SelectObject(hdc, g_hFontSub);
                SetTextColor(hdc, g_lbl2_col);
                TextOutW(hdc, 45, 68, g_lbl2_w, (int)wcslen(g_lbl2_w));
            }

            // 3. Dibujar Badge / Insignia Pill
            if (g_badge_act && wcslen(g_badge_w) > 0) {
                SelectObject(hdc, g_hFontBadge);
                SetTextColor(hdc, g_badge_col);
                int badge_width = (int)wcslen(g_badge_w) * 9 + 24;
                RECT rcBadge = { g_badge_x, g_badge_y, g_badge_x + badge_width, g_badge_y + 26 };
                HBRUSH bDark = CreateSolidBrush(RGB(24, 28, 36));
                FillRect(hdc, &rcBadge, bDark);
                DeleteObject(bDark);
                FrameRect(hdc, &rcBadge, (HBRUSH)GetStockObject(GRAY_BRUSH));
                TextOutW(hdc, g_badge_x + 10, g_badge_y + 4, g_badge_w, (int)wcslen(g_badge_w));
            }

            // 4. Barra 1 (Salud / Principal)
            if (g_p1_act && g_p1_w > 0) {
                SelectObject(hdc, g_hFontBar);
                SetTextColor(hdc, RGB(226, 232, 240));
                TextOutW(hdc, g_p1_x, g_p1_y - 18, g_p1_tag_w, (int)wcslen(g_p1_tag_w));

                RECT rc1 = { g_p1_x, g_p1_y, g_p1_x + g_p1_w, g_p1_y + g_p1_h };
                HBRUSH bBg1 = CreateSolidBrush(RGB(28, 30, 36));
                FillRect(hdc, &rc1, bBg1);
                DeleteObject(bBg1);

                int fill1 = (g_p1_w * g_p1_val) / 100;
                if (fill1 > g_p1_w) fill1 = g_p1_w;
                if (fill1 > 0) {
                    RECT rcF1 = { g_p1_x, g_p1_y, g_p1_x + fill1, g_p1_y + g_p1_h };
                    HBRUSH bFill1 = CreateSolidBrush(g_p1_col);
                    FillRect(hdc, &rcF1, bFill1);
                    DeleteObject(bFill1);
                }
                FrameRect(hdc, &rc1, (HBRUSH)GetStockObject(GRAY_BRUSH));
            }

            // 5. Barra 2 (Escudo / Secundaria)
            if (g_p2_act && g_p2_w > 0) {
                SelectObject(hdc, g_hFontBar);
                SetTextColor(hdc, RGB(226, 232, 240));
                TextOutW(hdc, g_p2_x, g_p2_y - 18, g_p2_tag_w, (int)wcslen(g_p2_tag_w));

                RECT rc2 = { g_p2_x, g_p2_y, g_p2_x + g_p2_w, g_p2_y + g_p2_h };
                HBRUSH bBg2 = CreateSolidBrush(RGB(28, 30, 36));
                FillRect(hdc, &rc2, bBg2);
                DeleteObject(bBg2);

                int fill2 = (g_p2_w * g_p2_val) / 100;
                if (fill2 > g_p2_w) fill2 = g_p2_w;
                if (fill2 > 0) {
                    RECT rcF2 = { g_p2_x, g_p2_y, g_p2_x + fill2, g_p2_y + g_p2_h };
                    HBRUSH bFill2 = CreateSolidBrush(g_p2_col);
                    FillRect(hdc, &rcF2, bFill2);
                    DeleteObject(bFill2);
                }
                FrameRect(hdc, &rc2, (HBRUSH)GetStockObject(GRAY_BRUSH));
            }

            EndPaint(hwnd, &ps);
            return 0;
        }
    }
    return DefWindowProcW(hwnd, msg, wParam, lParam);
}

int main() {
    SetConsoleOutputCP(65001);
    SetConsoleCP(65001);

    char cfg_path[512];
    GetTempPathA(512, cfg_path);
    strcat(cfg_path, "_tiger_ui_pro.cfg");
    FILE* f = fopen(cfg_path, "r");
    if (!f) return 1;

    int w = 800, h = 550, fullscreen = 0, borderless = 0, topmost = 0, opacity = 96;
    char theme[32] = "tiger", bg_hex[32] = "#121214", title[256] = "Tiger Modern GUI";
    fscanf(f, "%d\n%d\n%d\n%d\n%d\n%d\n", &w, &h, &fullscreen, &borderless, &topmost, &opacity);
    fgets(theme, sizeof(theme), f); theme[strcspn(theme, "\r\n")] = 0;
    fgets(bg_hex, sizeof(bg_hex), f); bg_hex[strcspn(bg_hex, "\r\n")] = 0;
    fgets(title, sizeof(title), f); title[strcspn(title, "\r\n")] = 0;

    int l1_act, l1_x, l1_y; char l1_col[32], l1_txt[256];
    fscanf(f, "%d\n%d\n%d\n", &l1_act, &l1_x, &l1_y);
    fgets(l1_col, sizeof(l1_col), f); l1_col[strcspn(l1_col, "\r\n")] = 0;
    fgets(l1_txt, sizeof(l1_txt), f); l1_txt[strcspn(l1_txt, "\r\n")] = 0;

    int l2_act, l2_x, l2_y; char l2_col[32], l2_txt[256];
    fscanf(f, "%d\n%d\n%d\n", &l2_act, &l2_x, &l2_y);
    fgets(l2_col, sizeof(l2_col), f); l2_col[strcspn(l2_col, "\r\n")] = 0;
    fgets(l2_txt, sizeof(l2_txt), f); l2_txt[strcspn(l2_txt, "\r\n")] = 0;

    char b_col[32], b_txt[128];
    fscanf(f, "%d\n%d\n%d\n", &g_badge_act, &g_badge_x, &g_badge_y);
    fgets(b_col, sizeof(b_col), f); b_col[strcspn(b_col, "\r\n")] = 0;
    fgets(b_txt, sizeof(b_txt), f); b_txt[strcspn(b_txt, "\r\n")] = 0;

    char p1_col_hex[32], p1_tag[128];
    fscanf(f, "%d\n%d\n%d\n%d\n%d\n%d\n", &g_p1_act, &g_p1_val, &g_p1_x, &g_p1_y, &g_p1_w, &g_p1_h);
    fgets(p1_col_hex, sizeof(p1_col_hex), f); p1_col_hex[strcspn(p1_col_hex, "\r\n")] = 0;
    fgets(p1_tag, sizeof(p1_tag), f); p1_tag[strcspn(p1_tag, "\r\n")] = 0;

    char p2_col_hex[32], p2_tag[128];
    fscanf(f, "%d\n%d\n%d\n%d\n%d\n%d\n", &g_p2_act, &g_p2_val, &g_p2_x, &g_p2_y, &g_p2_w, &g_p2_h);
    fgets(p2_col_hex, sizeof(p2_col_hex), f); p2_col_hex[strcspn(p2_col_hex, "\r\n")] = 0;
    fgets(p2_tag, sizeof(p2_tag), f); p2_tag[strcspn(p2_tag, "\r\n")] = 0;

    int in_act, in_x, in_y, in_w, in_h; char in_txt[128];
    fscanf(f, "%d\n%d\n%d\n%d\n%d\n", &in_act, &in_x, &in_y, &in_w, &in_h);
    fgets(in_txt, sizeof(in_txt), f); in_txt[strcspn(in_txt, "\r\n")] = 0;

    int b1_act, b1_x, b1_y, b1_w, b1_h; char b1_txt[128];
    fscanf(f, "%d\n%d\n%d\n%d\n%d\n", &b1_act, &b1_x, &b1_y, &b1_w, &b1_h);
    fgets(b1_txt, sizeof(b1_txt), f); b1_txt[strcspn(b1_txt, "\r\n")] = 0;

    int b2_act, b2_x, b2_y, b2_w, b2_h; char b2_txt[128];
    fscanf(f, "%d\n%d\n%d\n%d\n%d\n", &b2_act, &b2_x, &b2_y, &b2_w, &b2_h);
    fgets(b2_txt, sizeof(b2_txt), f); b2_txt[strcspn(b2_txt, "\r\n")] = 0;
    fclose(f);

    // Conversion UTF-8 -> UTF-16 Unicode Wide
    wchar_t w_title[256];
    utf8_to_wide(title, w_title, 256);
    utf8_to_wide(l1_txt, g_lbl1_w, 256);
    utf8_to_wide(l2_txt, g_lbl2_w, 256);
    utf8_to_wide(b_txt, g_badge_w, 128);
    utf8_to_wide(p1_tag, g_p1_tag_w, 128);
    utf8_to_wide(p2_tag, g_p2_tag_w, 128);

    wchar_t w_in_txt[128];  utf8_to_wide(in_txt, w_in_txt, 128);
    wchar_t w_b1_txt[128];  utf8_to_wide(b1_txt, w_b1_txt, 128);
    wchar_t w_b2_txt[128];  utf8_to_wide(b2_txt, w_b2_txt, 128);

    g_bg_color = parse_hex(bg_hex, RGB(18, 18, 20));
    g_hBgBrush = CreateSolidBrush(g_bg_color);
    g_lbl1_col = parse_hex(l1_col, RGB(255, 107, 0));
    g_lbl2_col = parse_hex(l2_col, RGB(148, 163, 184));
    g_badge_col = parse_hex(b_col, RGB(34, 197, 94));
    g_p1_col = parse_hex(p1_col_hex, RGB(255, 107, 0));
    g_p2_col = parse_hex(p2_col_hex, RGB(0, 243, 255));

    WNDCLASSEXW wc;
    memset(&wc, 0, sizeof(wc));
    wc.cbSize = sizeof(WNDCLASSEXW);
    wc.style = CS_HREDRAW | CS_VREDRAW;
    wc.lpfnWndProc = _TigerWndProcModern;
    wc.hInstance = GetModuleHandleW(NULL);
    wc.hCursor = LoadCursorA(NULL, IDC_ARROW);
    wc.hbrBackground = g_hBgBrush;
    wc.lpszClassName = L"TigerModernUnicodeClass";
    RegisterClassExW(&wc);

    int screen_w = GetSystemMetrics(SM_CXSCREEN);
    int screen_h = GetSystemMetrics(SM_CYSCREEN);
    DWORD estilo = WS_VISIBLE;
    DWORD ex_estilo = 0;
    int pos_x = (screen_w - w) / 2;
    int pos_y = (screen_h - h) / 2;
    if (pos_x < 10) pos_x = 10;
    if (pos_y < 10) pos_y = 10;
    int real_w = w;
    int real_h = h;

    if (fullscreen) {
        estilo |= WS_POPUP;
        pos_x = 0; pos_y = 0; real_w = screen_w; real_h = screen_h;
    } else if (borderless) {
        estilo |= WS_POPUP;
    } else {
        estilo |= WS_OVERLAPPEDWINDOW;
        RECT rc = { 0, 0, w, h };
        AdjustWindowRect(&rc, estilo, FALSE);
        real_w = rc.right - rc.left;
        real_h = rc.bottom - rc.top;
    }

    if (topmost) ex_estilo |= WS_EX_TOPMOST;

    HWND hwnd = CreateWindowExW(
        ex_estilo, L"TigerModernUnicodeClass", w_title, estilo,
        pos_x, pos_y, real_w, real_h,
        NULL, NULL, wc.hInstance, NULL
    );

    if (!hwnd) {
        TIGER->error("No se pudo iniciar la ventana Unicode.");
        return 1;
    }

    if (opacity > 0 && opacity < 100) {
        typedef BOOL (WINAPI *pfnSetLayeredWindowAttributes)(HWND, COLORREF, BYTE, DWORD);
        HMODULE hUser = LoadLibraryA("user32.dll");
        if (hUser) {
            pfnSetLayeredWindowAttributes fnSetLayered = (pfnSetLayeredWindowAttributes)GetProcAddress(hUser, "SetLayeredWindowAttributes");
            if (fnSetLayered) {
                SetWindowLongA(hwnd, GWL_EXSTYLE, GetWindowLongA(hwnd, GWL_EXSTYLE) | 0x00080000);
                fnSetLayered(hwnd, 0, (BYTE)(opacity * 255 / 100), 2);
            }
        }
    }

    g_hFontTitle = CreateFontA(24, 0, 0, 0, FW_BOLD, FALSE, FALSE, FALSE, DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS, DEFAULT_QUALITY, DEFAULT_PITCH | FF_SWISS, "Segoe UI");
    g_hFontSub = CreateFontA(15, 0, 0, 0, FW_NORMAL, FALSE, FALSE, FALSE, DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS, DEFAULT_QUALITY, DEFAULT_PITCH | FF_SWISS, "Segoe UI");
    g_hFontBadge = CreateFontA(13, 0, 0, 0, FW_SEMIBOLD, FALSE, FALSE, FALSE, DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS, DEFAULT_QUALITY, DEFAULT_PITCH | FF_SWISS, "Consolas");
    g_hFontBar = CreateFontA(13, 0, 0, 0, FW_BOLD, FALSE, FALSE, FALSE, DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS, DEFAULT_QUALITY, DEFAULT_PITCH | FF_SWISS, "Segoe UI");
    HFONT hFontNormal = CreateFontA(16, 0, 0, 0, FW_NORMAL, FALSE, FALSE, FALSE, DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS, DEFAULT_QUALITY, DEFAULT_PITCH | FF_SWISS, "Segoe UI");

    if (in_act) {
        HWND hIn = CreateWindowExW(WS_EX_CLIENTEDGE, L"EDIT", w_in_txt, WS_CHILD | WS_VISIBLE | ES_LEFT | ES_AUTOHSCROLL, in_x, in_y, in_w, in_h, hwnd, NULL, wc.hInstance, NULL);
        SendMessageW(hIn, WM_SETFONT, (WPARAM)hFontNormal, TRUE);
    }

    if (b1_act) {
        HWND hBtn1 = CreateWindowExW(0, L"BUTTON", w_b1_txt, WS_CHILD | WS_VISIBLE | BS_PUSHBUTTON, b1_x, b1_y, b1_w, b1_h, hwnd, (HMENU)2001, wc.hInstance, NULL);
        SendMessageW(hBtn1, WM_SETFONT, (WPARAM)hFontNormal, TRUE);
    }

    if (b2_act) {
        HWND hBtn2 = CreateWindowExW(0, L"BUTTON", w_b2_txt, WS_CHILD | WS_VISIBLE | BS_PUSHBUTTON, b2_x, b2_y, b2_w, b2_h, hwnd, (HMENU)2002, wc.hInstance, NULL);
        SendMessageW(hBtn2, WM_SETFONT, (WPARAM)hFontNormal, TRUE);
    }

    TIGER->imprimir("Ventana Unicode lanzada: '%s' (%d x %d px).", title, w, h);
    TIGER->exito("Interfaz cargada con soporte UTF-8 completo.");

    ShowWindow(hwnd, SW_SHOW);
    UpdateWindow(hwnd);
    MSG msg;
    while (GetMessageW(&msg, NULL, 0, 0) > 0) {
        TranslateMessage(&msg);
        DispatchMessageW(&msg);
    }

    DeleteObject(g_hBgBrush);
    DeleteObject(g_hFontTitle);
    DeleteObject(g_hFontSub);
    DeleteObject(g_hFontBadge);
    DeleteObject(g_hFontBar);
    DeleteObject(hFontNormal);
    return 0;
}
#else
int main() {
    TIGER->imprimir("Ventana Unicode en macOS/POSIX.");
    return 0;
}
#endif
    },
    RETORNAR 1
}.

FN window_open(CAD t | ENT w | ENT h) {
    ventana_abrir(t | w | h),
    RETORNAR 1
}.

