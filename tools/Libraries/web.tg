    _tiger_lbl2_txt <- txt,
    _tiger_lbl2_col <- col_hex,
    RETORNAR 1
}.

FN insignia_configurar(CAD txt | CAD col_hex) {
    _tiger_badge_act <- 1,
    _tiger_badge_txt <- txt,
    _tiger_badge_col <- col_hex,
    RETORNAR 1
}.

