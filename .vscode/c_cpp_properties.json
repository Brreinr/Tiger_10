{
  "configurations": [
    {
      "name": "Tiger-TCC",
      "includePath": [
        "${workspaceFolder}/**",
        "${workspaceFolder}/bin/tcc/include",
        "${workspaceFolder}/bin/tcc/include/winapi",
        "${workspaceFolder}/bin/tcc/include/sec_api",
        "${workspaceFolder}/bin/tcc/include/sys",
        "${workspaceFolder}/src"
      ],
      "defines": [
        "_WIN32",
        "_WIN64",
        "__TINYC__"
      ],
      "cStandard": "c11",
      "cppStandard": "c++17",
      "intelliSenseMode": "windows-gcc-x64"
    }
  ],
  "version": 4
}
