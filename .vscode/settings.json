{
  "files.associations": {
    "*.tg": "tiger"
  },
  "workbench.colorCustomizations": {
    "editor.background": "#0B0C0E",
    "editor.foreground": "#FFFFFF",
    "editorCursor.foreground": "#FFE600",
    "editor.lineHighlightBackground": "#15171D",
    "editor.selectionBackground": "#FF6B003D"
  },
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": [
          "keyword.control",
          "keyword.control.conditional.tiger",
          "keyword.control.loop.tiger",
          "keyword.control.return.tiger",
          "keyword.control.import.tiger",
          "keyword.declaration.function.tiger",
          "keyword.declaration.macro.tiger"
        ],
        "settings": {
          "foreground": "#FF6B00",
          "fontStyle": "bold"
        }
      },
      {
        "scope": [
          "storage.modifier",
          "storage.modifier.tiger"
        ],
        "settings": {
          "foreground": "#FF8500",
          "fontStyle": "bold"
        }
      },
      {
        "scope": [
          "storage.type",
          "storage.type.tiger"
        ],
        "settings": {
          "foreground": "#FFAA00",
          "fontStyle": "bold"
        }
      },
      {
        "scope": [
          "support.function",
          "support.function.tiger"
        ],
        "settings": {
          "foreground": "#FFE600",
          "fontStyle": "bold"
        }
      },
      {
        "scope": [
          "keyword.control.directive",
          "keyword.control.directive.tiger"
        ],
        "settings": {
          "foreground": "#FFD000",
          "fontStyle": "bold"
        }
      },
      {
        "scope": [
          "constant.language.boolean",
          "constant.language.boolean.tiger",
          "constant.numeric"
        ],
        "settings": {
          "foreground": "#FFFF00"
        }
      },
      {
        "scope": [
          "string",
          "string.quoted.double.tiger"
        ],
        "settings": {
          "foreground": "#FFFFFF"
        }
      },
      {
        "scope": [
          "keyword.operator"
        ],
        "settings": {
          "foreground": "#FF5500",
          "fontStyle": "bold"
        }
      },
      {
        "scope": [
          "punctuation.terminator.period.tiger"
        ],
        "settings": {
          "foreground": "#FFAA00",
          "fontStyle": "bold"
        }
      },
      {
        "scope": [
          "variable",
          "variable.other"
        ],
        "settings": {
          "foreground": "#FFFFFF"
        }
      }
    ]
  },
  "code-runner.executorMapByFileExtension": {
    ".tg": "& \"$workspaceRoot\\bin\\tiger.exe\" \"$fullFileName\" --run --fix",
    ".tgi": "& \"$workspaceRoot\\bin\\tiger.exe\" \"$fullFileName\" --run --fix",
    ".c": "& \"$workspaceRoot\\bin\\tiger.exe\" \"$fullFileName\"",
    ".cpp": "& \"$workspaceRoot\\bin\\tiger.exe\" \"$fullFileName\""
  },
  "code-runner.runInTerminal": true,
  "code-runner.saveFileBeforeRun": true,
  "workbench.iconTheme": "tiger-icons",
  "code-runner.executorMap": {
    "tiger": "& \"$workspaceRoot\\bin\\tiger.exe\" \"$fullFileName\" --run --fix",
    "c": "& \"$workspaceRoot\\bin\\tiger.exe\" \"$fullFileName\""
  },
  "C_Cpp_Runner.cCompilerPath": "${workspaceFolder}/bin/tcc/tcc.exe",
  "C_Cpp_Runner.cppCompilerPath": "${workspaceFolder}/bin/tcc/tcc.exe",
  "C_Cpp_Runner.includePaths": [
    "${workspaceFolder}/bin/tcc/include",
    "${workspaceFolder}/bin/tcc/include/winapi"
  ],
  "C_Cpp_Runner.debuggerPath": "gdb",
  "C_Cpp_Runner.cStandard": "",
  "C_Cpp_Runner.cppStandard": "",
  "C_Cpp_Runner.msvcBatchPath": "C:/Program Files/Microsoft Visual Studio/VR_NR/Community/VC/Auxiliary/Build/vcvarsall.bat",
  "C_Cpp_Runner.useMsvc": false,
  "C_Cpp_Runner.warnings": [
    "-Wall",
    "-Wextra",
    "-Wpedantic",
    "-Wshadow",
    "-Wformat=2",
    "-Wcast-align",
    "-Wconversion",
    "-Wsign-conversion",
    "-Wnull-dereference"
  ],
  "C_Cpp_Runner.msvcWarnings": [
    "/W4",
    "/permissive-",
    "/w14242",
    "/w14287",
    "/w14296",
    "/w14311",
    "/w14826",
    "/w44062",
    "/w44242",
    "/w14905",
    "/w14906",
    "/w14263",
    "/w44265",
    "/w14928"
  ],
  "C_Cpp_Runner.enableWarnings": true,
  "C_Cpp_Runner.warningsAsError": false,
  "C_Cpp_Runner.compilerArgs": [],
  "C_Cpp_Runner.linkerArgs": [],
  "C_Cpp_Runner.includePaths": [],
  "C_Cpp_Runner.includeSearch": [
    "*",
    "**/*"
  ],
  "C_Cpp_Runner.excludeSearch": [
    "**/build",
    "**/build/**",
    "**/.*",
    "**/.*/**",
    "**/.vscode",
    "**/.vscode/**"
  ],
  "C_Cpp_Runner.useAddressSanitizer": false,
  "C_Cpp_Runner.useUndefinedSanitizer": false,
  "C_Cpp_Runner.useLeakSanitizer": false,
  "C_Cpp_Runner.showCompilationTime": false,
  "C_Cpp_Runner.useLinkTimeOptimization": false,
  "C_Cpp_Runner.msvcSecureNoWarnings": false
}