{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Tiger: ejecutar con intérprete (experimental)",
      "type": "process",
      "command": "${workspaceFolder}\\bin\\tiger.exe",
      "args": [
        "${file}",
        "--run",
        "--fix"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Tiger: ejecutar binario nativo Windows x64",
      "type": "process",
      "command": "${workspaceFolder}\\bin\\tiger.exe",
      "args": [
        "${file}",
        "--run-native",
        "--fix"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Tiger: compilar ASM (.asm)",
      "type": "process",
      "command": "${workspaceFolder}\\bin\\tiger.exe",
      "args": [
        "${file}",
        "--target",
        "asm",
        "--fix",
        "-o",
        "${fileDirname}\\${fileBasenameNoExtension}.asm"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Tiger: compilar WebAssembly (.wat)",
      "type": "process",
      "command": "${workspaceFolder}\\bin\\tiger.exe",
      "args": [
        "${file}",
        "--target",
        "wat",
        "--fix",
        "-o",
        "${fileDirname}\\${fileBasenameNoExtension}.wat"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}
