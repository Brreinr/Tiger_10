# Test del Recolector de Basura con Temporizador en Segundo Plano (Tiger Timed GC)
IMPRIMIR "=== PRUEBA DE TIGER TIMED GC EN SEGUNDO PLANO ===".

# 1. Iniciar GC con temporizador de fondo cada 200 ms
gc_iniciar(200).
IMPRIMIR "GC Temporizado iniciado (intervalo: 200 ms)".

# 2. Asignar gran cantidad de memoria en bucle para generar carga
ENT VAR i = 0.
MIENTRAS i < 50000 {
    VAR d = {"clave": "valor_de_prueba", "iter": i}.
    i <- i + 1.
}.

# 3. Forzar recolección manual o esperar al temporizador
ENT VAR liberados = gc_recolectar().
IMPRIMIR "Bytes compactados inmediatamente: " + liberados.

# 4. Consultar telemetría del GC
VAR stats = gc_estadisticas().
IMPRIMIR "Telemetria GC: " + stats.

# 5. Detener el recolector
gc_detener().
IMPRIMIR "GC en segundo plano detenido exitosamente.".
IMPRIMIR "=== FIN DE PRUEBA ===".

